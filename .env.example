# Public MCP gateway
NEXORA_GATEWAY_HOST=127.0.0.1
NEXORA_GATEWAY_PORT=8765
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXORA_PUBLIC_TOKEN=replace-with-at-least-32-random-characters

# MCP DNS-rebinding allowlist. Add your stable Cloudflare/ngrok hostname.
NEXORA_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
NEXORA_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*

# Local Blender bridge
NEXORA_BRIDGE_URL=http://127.0.0.1:9876
NEXORA_BRIDGE_SECRET=replace-with-a-different-32-character-secret
NEXORA_REQUEST_TIMEOUT_SECONDS=120

# safe | standard | unrestricted
NEXORA_PERMISSION_PROFILE=standard
# Must ALSO be true to expose blender_execute_python.
NEXORA_ALLOW_PYTHON_EXEC=false

# Blender file access should remain inside this workspace.
NEXORA_WORKSPACE_ROOT=~/NexoraForgeWorkspace

# Operations
NEXORA_AUDIT_LOG=./var/audit.jsonl
NEXORA_LOG_LEVEL=INFO
